# Modelo de segredos do Streamlit. Copie para `.streamlit/secrets.toml` (que está no .gitignore) ou cole o conteúdo no campo
# "Secrets" do Streamlit Community Cloud. A chave é opcional: sem ela, cada pessoa digita a própria no campo da barra lateral.
# Nunca coloque uma chave real neste arquivo de exemplo.
GROQ_API_KEY = "cole-aqui-a-chave-do-groq"
